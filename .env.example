# ==============================================================================
# Career Command Center — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI & Google Search Grounding Engine
# ------------------------------------------------------------------------------
# Required for AI-powered candidate evidence extraction and live Google Search grounded discovery.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides (defaults to gemini-3.8-flash with gemini-3.7-flash failover)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAILOVER_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Persistence & Auth (V3.2 Cloud Architecture)
# ------------------------------------------------------------------------------
# Required for multi-device sync, PostgreSQL RLS persistence, and cloud authentication.
# If omitted or unconfigured, Career Command Center runs smoothly in Local-First Browser Mode (localStorage).
# Obtain credentials at: https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL (Browser & Server safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Publishable / Anon Key (Browser & Server safe, governed by PostgreSQL Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Legacy compatibility alternative)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Side Supabase Service Role Key (NEVER expose to browser / prefix with NEXT_PUBLIC_)
# Used exclusively by /api/discovery/cron for multi-user batch scheduled discovery.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Scheduled Discovery Automation & Vercel Cron Security
# ------------------------------------------------------------------------------
# Secret token to protect /api/discovery/cron from unauthorized public invocation.
# Set this to a high-entropy random string and pass as Bearer token in Vercel Cron headers.
CRON_SECRET=your_secure_random_cron_secret_here

# ------------------------------------------------------------------------------
# 4. Optional Application Tuning
# ------------------------------------------------------------------------------
# Discovery provider override: 'gemini' | 'curated' (defaults to 'gemini' when key present)
# DISCOVERY_PROVIDER_DEFAULT=gemini
